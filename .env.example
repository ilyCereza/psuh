# Puerto del servidor (Render/Railway/Heroku inyectan PORT automáticamente)
PORT=3000

# Orígenes permitidos por CORS (separados por coma o * para permitir todos)
CORS_ORIGIN=*

# Contacto VAPID (formato mailto:correo@dominio.com o https://tu-dominio.com)
VAPID_SUBJECT=mailto:admin@fakestore-pwa.local

# Claves VAPID (generar con: npm run generate-vapid)
VAPID_PUBLIC_KEY=REEMPLAZAR_CON_CLAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=REEMPLAZAR_CON_CLAVE_PRIVADA_VAPID
